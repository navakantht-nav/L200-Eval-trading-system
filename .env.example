# ============================================================================
# Google Cloud & Gemini Enterprise Agent Platform (GEAP) Runtime Configuration
# ============================================================================
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Alternative: Google AI Studio API Key (set GOOGLE_GENAI_USE_VERTEXAI=FALSE)
# GOOGLE_API_KEY=your-gemini-api-key

# Model Routing Configuration
ALPHAPULSE_COORDINATOR_MODEL=gemini-2.5-flash
ALPHAPULSE_ANALYST_MODEL=gemini-2.5-flash
ALPHAPULSE_RISK_CRITIC_MODEL=gemini-2.5-pro

# Session & Memory Persistence ("in_memory", "sqlite", or "vertex_ai")
ALPHAPULSE_SESSION_BACKEND=in_memory
ALPHAPULSE_MEMORY_BACKEND=in_memory
ALPHAPULSE_SESSION_DB_URL=sqlite+aiosqlite:///./.adk/alphapulse_sessions.db
# VERTEX_AI_AGENT_ENGINE_ID=projects/your-gcp-project-id/locations/us-central1/reasoningEngines/1234567890

# Standalone MCP Toolkit Endpoint & OAuth 2.1 / Agent Identity Auth
ALPHAPULSE_MCP_SERVER_URL=http://127.0.0.1:8080/mcp
ALPHAPULSE_MCP_TRANSPORT=in_process
ALPHAPULSE_OAUTH_ISSUER=https://auth.alphapulse.local
ALPHAPULSE_OAUTH_AUDIENCE=alphapulse-mcp-toolkit
ALPHAPULSE_OAUTH_CLIENT_ID=alphapulse-trader-web
ALPHAPULSE_DEV_JWT_SECRET=alphapulse-local-dev-hmac-secret-change-in-prod

# Federated Remote A2A Macro Intelligence Endpoint
ALPHAPULSE_MACRO_A2A_URL=http://127.0.0.1:8080/a2a/macro

# GEAP Govern: Model Armor & Deterministic Risk Thresholds
# ALPHAPULSE_MODEL_ARMOR_TEMPLATE=projects/your-gcp-project-id/locations/us-central1/templates/alphapulse-floor
ALPHAPULSE_TRADING_MODE=PAPER
ALPHAPULSE_DEFAULT_STARTING_CASH_USD=250000.0
ALPHAPULSE_MAX_SINGLE_ORDER_USD=50000.0
ALPHAPULSE_MAX_POSITION_WEIGHT_PCT=25.0
ALPHAPULSE_MAX_PORTFOLIO_VAR_95_PCT=3.5
ALPHAPULSE_RESTRICTED_TICKERS=MEME,PUMP,FRAUD

# OpenTelemetry & Cloud Trace
ALPHAPULSE_ENABLE_CLOUD_TRACE=FALSE
OTEL_SERVICE_NAME=alphapulse-trading-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
